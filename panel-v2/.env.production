# Public build-time defaults, committed on purpose.
#
# Next.js loads this file during `next build` but does NOT override variables
# that already exist in process.env — so anything set in the Vercel dashboard
# still wins. Treat these as defaults, not as the source of truth.
#
# Both values are public by design:
#   - the project URL is in every request the browser makes;
#   - the anon key is Supabase's *publishable* key, shipped to the client on
#     purpose. It is already in .env.example and in the design prototype.
# What protects the data is RLS, which is enabled on every table.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET or TRACK_LINK_SECRET here.
# Those are real secrets and belong only in the Vercel dashboard, where they
# are not committed and not exposed to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://yhrvpgkxywwgeelhjszb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zwHVMn87dm7xJ1aB-_p7Xg_iUypsY-L
