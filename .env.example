# --- Supabase (panel veritabani) ---
SUPABASE_URL=https://yhrvpgkxywwgeelhjszb.supabase.co
# Dashboard > Project Settings > API Keys > service_role
# DIKKAT: bu anahtar RLS'i baypas eder. Sadece burada dursun, panele/repoya KOYMA.
SUPABASE_SERVICE_KEY=

# --- HenrikDev API ---
# Key almak icin: https://api.henrikdev.xyz/dashboard/ (Discord uyeligi gerekiyor)
HENRIK_API_KEY=

# Dakikada kac istek atilabilir. Basic key = 30, Enhanced key = 90.
# Cache miss'lerde HenrikDev cift sayim yaptigi icin guvenli tarafta kal.
HENRIK_RATE_LIMIT_PER_MIN=30

# --- Poll ayarlari ---
# Aktif siparislerin kac saniyede bir yoklanacagi. 300 = 5 dk.
POLL_INTERVAL_SECONDS=300

# Son mactan bu kadar dakika gecerse "seans bitti" sayilir ve ozet gonderilir.
SESSION_GAP_MINUTES=20

# Bu kadar saattir hic mac yoksa OPERATOR'e uyari gider (musteriye gitmez).
STALL_ALERT_HOURS=24

# Ust uste bu kadar maglubiyette OPERATOR'e uyari gider (musteriye gitmez).
LOSS_STREAK_ALERT=3

# Musteriye giden her mesajin kopyasi operator kanalina da dussun mu?
# true = seans ozetleri ve rank atlamalari sana da gelir (yogun ama tam gorunurluk)
# false = sadece uyarilar gelir (maglubiyet serisi, takilma, act degisimi, hata)
MIRROR_TO_OPS=true

# --- Telegram ---
# @BotFather'dan alinan token
TELEGRAM_BOT_TOKEN=
# Operator bildirimlerinin dusecegi chat/grup ID'si
TELEGRAM_OPS_CHAT_ID=
# Komut calistirabilecek kullanici ID'leri, virgulle ayrilmis.
# BOS BIRAKILIRSA bot sadece TELEGRAM_OPS_CHAT_ID sohbetinde komut kabul eder.
# Musteri sohbetlerinde /musteri calistirabilmek icin kendi ID'ni buraya ekle.
TELEGRAM_ADMIN_IDS=

# --- Discord ---
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=
# Operator bildirimlerinin dusecegi kanal ID'si
DISCORD_OPS_CHANNEL_ID=
# Slash komutlarinin aninda gorunmesi icin sunucu ID'si (bos birakilirsa global sync,
# yayilmasi 1 saate kadar surebilir)
DISCORD_GUILD_ID=
# Komut calistirabilecek kullanici ID'leri, virgulle ayrilmis.
# BOS BIRAKILIRSA bot sadece DISCORD_OPS_CHANNEL_ID kanalinda komut kabul eder.
DISCORD_ADMIN_IDS=

# Bot token'i yoksa operator bildirimleri buraya gonderilir (kanal ayarlari > Entegrasyonlar).
# Webhook mesaj GONDERIR ama komut ALAMAZ - komutlar icin Telegram ya da Discord bot sart.
# Musteri bildirimleri de webhook uzerinden gitmez, cunku webhook tek kanala baglidir.
DISCORD_WEBHOOK_URL=

# --- Veritabani ---
DB_PATH=orders.db
